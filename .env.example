# Client-safe (bundled into the browser). Never put service-role / secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: same values for SSR (Nitro / Cloudflare Worker). Prefer VITE_* for the SPA.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# PRODUCTION (Cloudflare Worker + official domain)
# Local development: leave VITE_PUBLIC_APP_URL unset so window.location.origin is used.
# ---------------------------------------------------------------------------
# Official canonical origin (no trailing slash, no www):
VITE_PUBLIC_APP_URL=https://usepetid.com.br

# Worker / SSR secrets (Cloudflare dashboard → Worker → Settings → Variables):
# SUPABASE_URL=...
# SUPABASE_PUBLISHABLE_KEY=...
# Do NOT set SUPABASE_SERVICE_ROLE_KEY on the Worker unless a server route needs it.
# Never expose service-role / Stripe secrets via VITE_*.

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets):
# PUBLIC_APP_URL=https://usepetid.com.br
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GUARDIAO_MONTHLY=price_...
# STRIPE_PRICE_GUARDIAO_YEARLY=price_...
# STRIPE_PRICE_FAMILIA_MONTHLY=price_...
# STRIPE_PRICE_FAMILIA_YEARLY=price_...
# STRIPE_PRICE_GUARDIAO_FOUNDER_YEARLY=price_...   # optional R$ 89/year
# STRIPE_PRICE_FAMILIA_FOUNDER_YEARLY=price_...    # optional R$ 129/year
#
# Deploy functions:
#   npx supabase functions deploy create-checkout create-portal stripe-webhook
# Webhook endpoint:
#   https://ukcyjqzfsxuvtepnluxz.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.paid
